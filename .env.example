# Copy to .env (production) or .env.development (local) and fill in.
# NEVER commit a filled-in copy. Rotate any key that has been shared or pasted.

ENVIRONMENT=development

# ── External APIs (both are metered / billable) ───────────────────────
IKANOON_TOKEN=your_indiankanoon_token
GROQ_API_KEY=your_groq_key

# ── Supabase ──────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
# Write path only. BYPASSES row level security — never expose to a client.
SUPABASE_SERVICE_KEY=your_service_key
# Public read path. RLS applies, so the is_published policy is enforced.
SUPABASE_ANON_KEY=your_anon_key

# ── Spend caps on the IndianKanoon API (per pipeline run) ──────────────
# Enforced in every environment. ₹0.50 per search + ₹0.20 per document.
MAX_IKANOON_CALLS=500
DEV_MAX_IKANOON_CALLS=50

# ── HTTP ──────────────────────────────────────────────────────────────
# Comma-separated or JSON list. '*' is rejected (CORS uses credentials).
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
# Rate limits, slowapi syntax.
FEED_RATE_LIMIT=30/minute
PREVIEW_RATE_LIMIT=60/minute
# Addresses/CIDRs of your load balancer or CDN. X-Forwarded-For is ONLY
# trusted when the connecting peer is listed here; otherwise any client can
# forge the header and bypass rate limiting. Leave empty if not behind a proxy.
TRUSTED_PROXIES=

# ── Reviewer preview tool (/preview) ──────────────────────────────────
# These endpoints publish and permanently delete cards. Defaults to on in
# development, off in production. In production it will refuse to mount unless
# credentials are set (password must be at least 12 characters).
ENABLE_PREVIEW_UI=true
REVIEWER_USERNAME=
REVIEWER_PASSWORD=
